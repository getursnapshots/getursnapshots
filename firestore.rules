rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidSlide(data) {
      return data.keys().hasAll(['slideIndex', 'videoUrl']) &&
             data.keys().hasOnly(['slideIndex', 'videoUrl', 'posterUrl', 'updatedAt']) &&
             data.slideIndex is int &&
             data.slideIndex >= 0 && data.slideIndex <= 30 &&
             data.videoUrl is string &&
             data.videoUrl.size() > 0 && data.videoUrl.size() <= 20000 &&
             (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 500000)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['clientName', 'phone', 'service', 'createdAt']) &&
             data.keys().hasOnly(['clientName', 'phone', 'email', 'service', 'package', 'eventDate', 'city', 'country', 'requirements', 'status', 'createdAt']) &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data['service'] is string && data['service'].size() > 0 && data['service'].size() <= 100 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('package' in data) || (data['package'] is string && data['package'].size() <= 100)) &&
             (!('eventDate' in data) || (data.eventDate is string && data.eventDate.size() <= 50)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 10)) &&
             (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 5000)) &&
             (!('status' in data) || (data.status is string && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'completed' || data.status == 'cancelled')));
    }

    // Connection validation probe
    match /test/{docId} {
      allow read: if true;
    }

    // Portfolio Slides collection:
    // Public read for website visitors to view video portfolio reels
    // Validated create/update for updating reel slides
    match /slides/{slideId} {
      allow get, list: if true;
      allow create, update: if isValidId(slideId) && isValidSlide(request.resource.data);
      allow delete: if isValidId(slideId);
    }

    // Bookings collection:
    // Public create for prospective clients submitting quotes/bookings
    // Authenticated access for reading/updating booking records
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId) && isValidBooking(request.resource.data);
      allow read, update, delete: if isValidId(bookingId) && request.auth != null;
    }

    // Global default-deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
